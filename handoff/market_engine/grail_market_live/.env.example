# Optional production connectors.
# eBay sold-history access is Limited Release; use credentials only after approval.
EBAY_MARKETPLACE_INSIGHTS_TOKEN=
EBAY_MARKETPLACE_INSIGHTS_ENDPOINT=

# Turn public-page connectors on/off.
ENABLE_FANATICS_PUBLIC=true
ENABLE_PSA_PUBLIC=false

# Optional exact/public result pages for a specific card can be supplied by an admin.
PSA_APR_URL=
REFRESH_SECONDS=900
